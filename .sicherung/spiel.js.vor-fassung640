  function geschenkePruefen() {
    if (!S.bereit || !S.ich || S.geschenkLaeuft) return;
    var jetzt = Date.now();
    var geschenk = Boolean(S.ich.geschenk_offen);
    var seite = !S.seiteZeit || jetzt - S.seiteZeit > 300000;
    if (!geschenk && !seite) return;
    S.geschenkLaeuft = true;
    var kette = Promise.resolve();
    /* Nur übernehmen, was wirklich ein ganzer Spielstand ist (mit id) —
       sonst würde eine leere Antwort den eigenen Stand überschreiben. */
    if (geschenk) kette = rpc("spiel_tagesgeschenk", {}).then(function (r) {
      if (!r || !r.ok || !r.id) return;
      S.ich = r; S.stand[r.id] = oeffentlich(r);
      ton("geschenk", 0.5);
      hinweis("🎁 Tagesgeschenk (Tag " + r.serie + " von 7): +" + r.punkte_plus + " Punkte, +" + r.bratwurst_plus + " Bratwurst"
        + (r.pflaster_plus ? ", +1 Pflaster" : "") + ", +20 Erfahrung");
    });
    kette.then(function () {
      if (!seite) return null;
      S.seiteZeit = jetzt;
      return rpc("spiel_seite_abholen", {});
    }).then(function (r) {
      S.geschenkLaeuft = false;
      if (!r || !r.ok || !r.id) return;
      S.ich = r; S.stand[r.id] = oeffentlich(r);
      if (r.muenzen > 0 || r.bratwurst_plus > 0) {
        setTimeout(function () {
          hinweis("📚 Für deine Übungen auf der Seite: +" + r.muenzen + " Punkte" + (r.bratwurst_plus ? ", +" + r.bratwurst_plus + " Bratwurst" : ""));
        }, geschenk ? 3000 : 0);
      }
      zeichnen(); panelAuffrischen();
    }).catch(function () { S.geschenkLaeuft = false; });
  }
  /* XANDER: „Superkraft … dämonisch aufgeladen". Die goldene Ladung
     oben am Bild füllt sich mit Deutsch (+8), Treffern (+2) und
     Einstecken (+3). Voll: 45 s ×1,5 Schaden, nur 70 % einstecken. */
  function superkraft() {
    rpc("spiel_superkraft", {}).then(function (r) {
      if (!r || !r.ok) { hinweis("🔥 " + ((r && r.grund) || "geht nicht")); return; }
      S.ich = r; S.stand[r.id] = oeffentlich(r);
      ton("gong", 0.55);
      senden({ ereignis: "stand", stand: oeffentlich(r) });
      senden({ ereignis: "daemon" });
