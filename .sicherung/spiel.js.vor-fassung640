  var panel = null, reiter = "start";
  function esc(t) { return String(t == null ? "" : t).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  /* Die Aufgaben tragen teils <strong> — nur das darf bleiben. */
  function frageHtml(t) { return esc(t).replace(/&lt;(\/?)strong&gt;/g, "<$1strong>"); }

  function menue(tab) {
    beitreten();
    if (!panel) {
      panel = document.createElement("div");
      panel.id = "spPanel";
      panel.className = "sp-panel";
      document.body.appendChild(panel);
      panel.addEventListener("click", panelKlick);
    }
    if (tab) reiter = tab;
    panel.hidden = false;
    panelAuffrischen();
  }
  function schliessen() { if (panel) panel.hidden = true; }

  function panelAuffrischen() {
    if (!panel || panel.hidden) return;
    var ich = S.ich;
    var kopf = '<div class="sp-kopf"><b>⚔️ Deutsch zum Überleben</b><button type="button" class="sp-zu" data-tu="zu" aria-label="Schließen">✕</button></div>';
    if (!ich) {
      panel.innerHTML = kopf + '<div class="sp-leer">' + esc(S.fehler || (S.versucht ? "Einen Moment – ich melde dich im Spiel an …" : "Das Spiel geht im Klassenzimmer.")) + "</div>";
      return;
    }
    var anteil = Math.max(0, Math.min(100, Math.round((ich.lp / ich.lp_max) * 100)));
    var xpSpanne = Math.max(1, (ich.xp_naechste || 100) - (ich.xp_stufe || 0));
    var xpAnteil = Math.max(0, Math.min(100, Math.round(((ich.xp || 0) - (ich.xp_stufe || 0)) / xpSpanne * 100)));
    var vorrat = ich.vorraete || {};
    var status = '<div class="sp-status">'
      + '<div class="sp-status-lp"><span class="sp-status-balken"><i style="width:' + anteil + '%"></i></span> <b>' + ich.lp + " / " + ich.lp_max + "</b> LP"
      + (ich.kaputt ? ' <span class="sp-rot">· kaputt</span>' : "") + (ich.anfaenger ? ' <span class="sp-blau">· Anfängerschutz</span>' : "") + "</div>"
      /* FASSUNG 634 — Level und Erfahrung */
      + '<div class="sp-status-lp"><span class="sp-status-balken sp-xp-balken"><i style="width:' + xpAnteil + '%"></i></span> <b>Level ' + (ich.level || 1) + "</b> · "
      + (ich.xp || 0) + " / " + (ich.xp_naechste || 100) + " Erfahrung" + (ich.skill_frei > 0 ? ' <span class="sp-gold">· ' + ich.skill_frei + " Skillpunkt" + (ich.skill_frei > 1 ? "e" : "") + " frei</span>" : "") + "</div>"
      + '<div class="sp-status-werte"><span>🪙 ' + ich.punkte + " Punkte</span><span>📚 " + ich.verdient + " verdient</span><span>🩹 " + ich.pflaster
      + "</span><span>🧪 " + ich.traenke + "</span><span>🛡️ " + Math.round((ich.ruestung || 0) * 100) + " % Rüstung</span>"
      + "<span>🔥 " + (ich.ladung || 0) + " % Ladung" + (wirkt(ich, "daemon") ? " · dämonisch " + wirkt(ich, "daemon") + " s" : "") + "</span>"
      + (ich.helm_stufe > 0 ? "<span>⛑️ Helm " + ich.helm_stufe + ": " + (ich.helm_halt || 0) + "/40</span>" : "")
      + (ich.brust_stufe > 0 ? "<span>Brustpanzer " + ich.brust_stufe + ": " + (ich.brust_halt || 0) + "/40</span>" : "")
      + (vorrat.bratwurst > 0 ? "<span>🌭 " + vorrat.bratwurst + " Bratwurst</span>" : "")
      + (ich.tag_serie > 0 ? "<span>🎁 Serie " + ich.tag_serie + "/7</span>" : "")
      /* FUNK 110 — Abnutzung sichtbar: wie lange hält es noch? */
      + (ich.haustier ? "<span>" + esc((TIERE[ich.haustier] || TIERE.fellmonster).name) + " " + (ich.haustier_leben || 0) + "/" + (ich.haustier_max || 30) + (ich.haustier_leben > 0 ? "" : " schwach") + "</span>" : "")
      + (ich.flugtier ? "<span>" + esc((TIERE[ich.flugtier] || TIERE.drache).name) + " " + (ich.flugtier_leben || 0) + "/" + (ich.flugtier_max || 25) + (ich.flugtier_leben > 0 ? "" : " schwach") + "</span>" : "")
      + (ich.geschuetz_ladungen > 0 ? "<span>Geschütz Stufe " + (ich.geschuetz_stufe || 1) + ": " + ich.geschuetz_ladungen + " Schuss</span>" : "")
      + "</div>"
      /* FUNK 106 — der zweite Balken: Mana, nur aus Deutsch (+6 je
         richtiger Aufgabe), für die Zaubertränke. */
      + '<div class="sp-status-lp"><span class="sp-status-balken sp-mana-balken"><i style="width:' + Math.max(0, Math.min(100, ich.mana || 0)) + '%"></i></span> <b>' + (ich.mana || 0) + " / 100</b> Mana</div>"
      + '<div class="sp-traenke">' + TRAENKE.map(function (t) {
          var n = ich["trank_" + t[0]] || 0, rest = wirkt(ich, t[0]);
          var mana = t[0] === "mana" ? 0 : 30;
          if (!n && !rest) return "";
          return '<button type="button" data-tu="trinken" data-t="' + t[0] + '"' + (n > 0 && (ich.mana || 0) >= mana && !rest ? "" : " disabled") + ">"
            + '<span class="sp-trank sp-trank-' + t[0] + '"></span>' + t[1] + " (" + n + ")" + (rest ? " · wirkt " + rest + " s" : "") + "</button>";
        }).join("") + "</div>"
      + (S.stillstand ? '<div class="sp-hinweis">🕊️ Waffenstillstand – die Tafel ist offen.</div>' : "")
