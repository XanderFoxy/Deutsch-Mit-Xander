    if (sp) return document.querySelector('#lcPlaetze .lc-platz[data-lc-platz="' + sp[1] + '"]');
    return document.querySelector('#lcPlaetze .lc-platz[data-lc-id="' + String(chatId).replace(/"/g, "") + '"]');
  }

