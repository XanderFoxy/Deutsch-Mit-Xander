@keyframes spGlutspur { from { transform: scale(1); opacity: .95; } to { transform: scale(.2) translateY(10px); opacity: 0; } }
.sp-feuer.sp-feuer-gold { filter: hue-rotate(-10deg) saturate(1.4) brightness(1.15); }
