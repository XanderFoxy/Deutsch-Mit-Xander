.sp-troph > span { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.sp-troph b { color: #f4f6fb; font: 700 12.5px/1.2 system-ui, sans-serif; }
.sp-troph-hat b { color: #ffe27a; }
