.sp-phoenix-glut svg { filter: drop-shadow(0 0 4px rgba(255, 140, 30, .95)) drop-shadow(0 0 10px rgba(255, 90, 20, .6)); }
.sp-glutspur { position: fixed; z-index: 9990; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; pointer-events: none;
