/* =========================================================
   FASSUNG 657 — Schaufenster ohne Spiel
   XANDER: „kann man da unsere Level auch anzeigen wenn man mit normalen
   Leuten chatten oder Livestream machen ohne dass wir spielen … die
   [Tiere] find ich schon ganz süß … wenn die immer mit dabei sind".
   Nur Levelzahl und Tiere, am Rand — die Gesichtsmitte bleibt frei.
   ========================================================= */
.sp-schau { position: absolute; pointer-events: none; z-index: 6; }
.sp-schau svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.sp-schau .sp-level circle { fill: #1d2330; stroke: #f2b705; stroke-width: 2; }
.sp-schau .sp-level text { fill: #fff; font: 800 11.5px system-ui, sans-serif; text-anchor: middle; }
/* Friedlich: keine Kampfhaltung, nur leises Atmen. */
.sp-tier.sp-tier-friedlich, .sp-flugtier.sp-tier-friedlich { pointer-events: none; }
.sp-tier-friedlich svg { animation: sp-friedlich-atmen 3.2s ease-in-out infinite; transform-origin: 50% 90%; }
@keyframes sp-friedlich-atmen { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035, .975); } }
.sp-sm-zeigen { flex-wrap: wrap; }
.sp-sm-zeigen span { flex-basis: 100%; margin-bottom: 2px; }
@media (prefers-reduced-motion: reduce) { .sp-tier-friedlich svg { animation: none; } }

/* =========================================================
   FASSUNG 658 — Feuer filigran, Superkraft sichtbar am Gegner,
   Deutsch-Reiter, erschöpfte Tiere, Flüssigkeit in den Ringen
   ========================================================= */
/* „diese Feuereffekte noch filigran … effektvoll": schmale Flammenzungen
   (Tropfen mit Spitze nach oben), die hochzüngeln, flackern und ausgehen. */
.sp-zunge { position: fixed; width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; z-index: 9994; pointer-events: none;
  border-radius: 50% 0 50% 50%; opacity: 0; mix-blend-mode: screen;
  background: radial-gradient(circle at 62% 38%, #fffbe0 0 16%, #ffd23c 36%, #ff7a18 64%, rgba(214, 40, 10, .0) 100%);
  filter: blur(.25px) drop-shadow(0 0 3px rgba(255, 120, 20, .8));
  animation: spZunge .8s cubic-bezier(.3, .6, .4, 1) forwards; }
.sp-zunge-gold { background: radial-gradient(circle at 62% 38%, #ffffff 0 18%, #fff0a0 38%, #ffc23a 66%, rgba(255, 140, 20, 0) 100%);
  filter: blur(.25px) drop-shadow(0 0 4px rgba(255, 210, 90, .95)); }
.sp-zunge-daemon { background: radial-gradient(circle at 62% 38%, #ffe6ff 0 14%, #d06bff 36%, #8a1fd1 62%, rgba(176, 23, 47, 0) 100%);
  filter: blur(.25px) drop-shadow(0 0 4px rgba(160, 40, 230, .95)); mix-blend-mode: normal; }
@keyframes spZunge {
  0% { opacity: 0; transform: translate(0, 0) rotate(-45deg) scale(calc(var(--gr, 1) * .3)); }
  18% { opacity: 1; transform: translate(calc(var(--drift) * .2), calc(var(--hoch) * -.2)) rotate(-45deg) scale(calc(var(--gr, 1) * 1.15), calc(var(--gr, 1) * 1.6)); }
  45% { opacity: .95; transform: translate(calc(var(--drift) * -.3), calc(var(--hoch) * -.5)) rotate(-38deg) scale(calc(var(--gr, 1) * .8), calc(var(--gr, 1) * 1.9)); }
  100% { opacity: 0; transform: translate(var(--drift), calc(var(--hoch) * -1)) rotate(-50deg) scale(calc(var(--gr, 1) * .25), calc(var(--gr, 1) * .9)); } }
.sp-glutfunke { position: fixed; width: 2.5px; height: 2.5px; margin: -1.25px 0 0 -1.25px; border-radius: 50%; z-index: 9994; pointer-events: none;
  background: #ffe08a; box-shadow: 0 0 4px 1px rgba(255, 150, 40, .9); opacity: 0; animation: spGlutfunke 1.1s ease-out forwards; }
.sp-glutfunke.sp-zunge-gold { background: #fffbe0; box-shadow: 0 0 4px 1px rgba(255, 215, 100, .95); }
.sp-glutfunke.sp-zunge-daemon { background: #f4c8ff; box-shadow: 0 0 5px 1px rgba(170, 50, 240, .95); }
@keyframes spGlutfunke { 0% { opacity: 0; transform: translate(0, 0); } 15% { opacity: 1; }
  100% { opacity: 0; transform: translate(var(--drift), calc(var(--hoch) * -1)); } }
/* Der Feuerstrahl flackert jetzt an den Rändern statt als glatter Balken. */
.sp-feuerstrahl { -webkit-mask-image: repeating-linear-gradient(90deg, #000 0 7px, rgba(0,0,0,.55) 9px, #000 12px); mask-image: repeating-linear-gradient(90deg, #000 0 7px, rgba(0,0,0,.55) 9px, #000 12px); }

/* „ich sehe keinen Effekt den es macht durch das Feuer, was ich auf den
   Gegner schicke": mit Superkraft fliegt die Kugel mit lila Schweif … */
.sp-geschoss.sp-g-daemon { filter: drop-shadow(0 0 3px #c04dff) drop-shadow(0 0 7px rgba(176, 23, 47, .85)); }
.sp-geschoss.sp-g-daemon::after { content: ""; position: absolute; right: 70%; top: 50%; width: 46px; height: 7px; margin-top: -3.5px; border-radius: 4px;
  background: linear-gradient(90deg, rgba(138, 31, 209, 0), rgba(176, 60, 230, .55) 55%, rgba(255, 190, 255, .95)); filter: blur(1.2px); }
.sp-laser.sp-g-daemon { filter: hue-rotate(260deg) saturate(1.6) drop-shadow(0 0 5px #b44dff); }
/* … und das getroffene Bild brennt kurz lila. */
.lc-platz.sp-daemon-brand .lc-kreis { animation: spDaemonBrand 1.2s ease-out; }
@keyframes spDaemonBrand { 0% { box-shadow: 0 0 0 0 rgba(170, 50, 240, 0); }
  20% { box-shadow: 0 0 0 4px rgba(170, 50, 240, .85), 0 0 22px 8px rgba(176, 23, 47, .6), inset 0 -18px 22px -8px rgba(150, 30, 220, .75); }
  100% { box-shadow: 0 0 0 0 rgba(170, 50, 240, 0), inset 0 0 0 0 rgba(150, 30, 220, 0); } }

/* „mein Fell … irgendwie schwächer dargestellt. Woran liegt das?"
   Erschöpft (0 Kraft) = grau und es schläft: „Zzz" steigt auf. */
.sp-tier.sp-tier-schwach::after, .sp-flugtier.sp-tier-schwach::after { content: "Zzz"; position: absolute; right: 0; top: 63%;
  font: italic 800 9px/1 system-ui, sans-serif; color: #eef2ff; text-shadow: 0 0 2px #1d2330, 0 0 3px #1d2330; letter-spacing: .5px;
  animation: spZzz 2.4s ease-in-out infinite; }
.sp-flugtier.sp-tier-schwach::after { top: 4%; right: -8%; }
@keyframes spZzz { 0%, 100% { opacity: .35; transform: translateY(0) scale(.9); } 50% { opacity: 1; transform: translateY(-4px) scale(1.05); } }
.sp-sm-warn { color: #ffd479 !important; }

/* „die Blasen in der Grafik, die die Flüssigkeit darstellen, das sind
   einfach nur Punkte die hoch und runter wandern — kann man das schöner
   gestalten". Statt der Punkte gleitet ein weicher Lichtglanz durch die
   Flüssigkeit, wie Licht auf einer Welle. */
.sp-lp .sp-flut { stroke: rgba(255, 255, 255, .5); stroke-width: 2.6; stroke-dasharray: 7 26; stroke-linecap: round;
  filter: blur(.7px); mix-blend-mode: screen; animation: spGlanz 3.4s linear infinite; }
@keyframes spGlanz { 0% { stroke-dashoffset: 0; opacity: .25; } 50% { opacity: .75; } 100% { stroke-dashoffset: -66; opacity: .25; } }
@media (prefers-reduced-motion: reduce) { .sp-lp .sp-flut { animation: none; opacity: .4; } }

/* Deutsch hat einen eigenen, grün markierten Reiter. */
.sp-sm-reiter { gap: 3px; }
.sp-sm-reiter button { flex: 1 1 auto; padding-left: 3px; padding-right: 3px; min-width: 0; font-size: 12.5px; }
.sp-sm-reiter button.sp-sm-deutsch { background: #1f6b3a; color: #eafff0; border-color: #3bbf4a; }
.sp-sm-reiter button.sp-sm-deutsch.sp-an { background: #3bbf4a; color: #10301c; }
.sp-sm-los { background: #3bbf4a !important; color: #10301c !important; font-weight: 800; }
.sp-sm-arten { flex-wrap: wrap; }

@media (prefers-reduced-motion: reduce) {
  .sp-zunge, .sp-glutfunke { animation-duration: .01s; }
  .sp-tier-schwach::after { animation: none; }
}

/* =========================================================
   FASSUNG 661 — Trophäen und Fundstücke
   ========================================================= */
.sp-troph-liste { display: flex; flex-direction: column; gap: 4px; max-height: 46vh; overflow-y: auto; padding-right: 2px; }
.sp-troph { display: flex; align-items: center; gap: 8px; padding: 5px 7px; border-radius: 9px; background: rgba(255, 255, 255, .05); }
.sp-troph-hat { background: linear-gradient(90deg, rgba(242, 194, 48, .22), rgba(242, 194, 48, .05)); }
