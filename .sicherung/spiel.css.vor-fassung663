.sp-schnell .sp-rad { position: absolute; bottom: calc(100% + 6px); z-index: 33; pointer-events: none; overflow: visible; animation: spRadAuf .18s ease-out; }
.sp-schnell .sp-rad-bogen { position: absolute; left: 0; top: 0; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle at 50% 50%, rgba(24,28,40,0) 22%, rgba(24,28,40,.82) 23%, rgba(24,28,40,.82) 70%, rgba(24,28,40,0) 71%);
  clip-path: inset(0 0 50% 0); }
.sp-schnell .sp-rad-waffe, .sp-schnell .sp-rad-mitte { position: absolute; width: 40px; height: 40px; min-width: 0; min-height: 0; border-radius: 50%;
  border: 0; background: #2f3749; color: #fff; pointer-events: auto; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 6px rgba(0,0,0,.4); padding: 0; margin: 0; }
.sp-schnell .sp-rad-waffe svg { width: 26px; height: 26px; }
