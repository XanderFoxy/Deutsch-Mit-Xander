.sp-phoenix-schwanz path { animation: spSchwanzWehen 1.4s ease-in-out infinite alternate; transform-box: view-box; transform-origin: 96px 19px; }
@keyframes spSchwanzWehen { from { transform: rotate(-3deg); } to { transform: rotate(4deg); } }
