.sp-troph em { display: block; height: 4px; border-radius: 2px; background: rgba(255, 255, 255, .1); overflow: hidden; margin-top: 2px; }
.sp-troph em u { display: block; height: 100%; background: linear-gradient(90deg, #3bbf4a, #f2c230); }

.sp-pokal-feier { position: fixed; z-index: 9995; pointer-events: none; width: 54px; margin-left: -27px; text-align: center;
  animation: spPokal 2.5s cubic-bezier(.2, .8, .3, 1) forwards; }
.sp-pokal-feier svg { width: 54px; height: 54px; filter: drop-shadow(0 0 6px rgba(255, 210, 80, .9)); }
.sp-pokal-feier b { display: block; white-space: nowrap; margin-left: 50%; transform: translateX(-50%); width: max-content;
  font: 800 12px system-ui, sans-serif; color: #ffe27a; text-shadow: 0 1px 2px #000, 0 0 4px #000; }
@keyframes spPokal { 0% { transform: translateY(-10px) scale(.3); opacity: 0; } 18% { transform: translateY(-70px) scale(1.15); opacity: 1; }
  30% { transform: translateY(-64px) scale(1); } 80% { transform: translateY(-78px) scale(1); opacity: 1; } 100% { transform: translateY(-96px) scale(.9); opacity: 0; } }

/* Das Fundstück: ein Säckchen mit Fragezeichen, das glitzert und leicht hüpft. */
.sp-fundsack { position: absolute; z-index: 8; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.sp-fundsack svg { width: 62%; height: 62%; animation: spFundHuepf 1.6s ease-in-out infinite; filter: drop-shadow(0 0 5px rgba(255, 220, 120, .85)); }
.sp-fundsack .sp-fundsack-funkeln { animation: spFundFunkeln 1.1s ease-in-out infinite alternate; }
@keyframes spFundHuepf { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9%); } }
@keyframes spFundFunkeln { from { opacity: .25; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .sp-fundsack svg, .sp-fundsack .sp-fundsack-funkeln, .sp-pokal-feier { animation-duration: .01s; } }

/* =========================================================
   FASSUNG 662 — Dorf, Titan-/Diamantmauer, Wassergraben, Turm auf freiem Platz
   ========================================================= */
.sp-graben { position: absolute; pointer-events: none; z-index: 4; }
.sp-graben svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.sp-graben-welle { animation: spGrabenWelle 2.6s ease-in-out infinite alternate; }
@keyframes spGrabenWelle { from { transform: translateX(-2%); } to { transform: translateX(2%); } }
.sp-diamant-funkeln { animation: spFundFunkeln 1.3s ease-in-out infinite alternate; }
.sp-mauer-diamant svg { filter: drop-shadow(0 0 2px rgba(155, 231, 255, .9)); }
/* Ein Turm, der auf einem freien Platz steht, sitzt in dessen Mitte. */
/* Das Turm-Bild sitzt sonst links unten am Bild (um 18 % / 82 %). Auf dem
   freien Platz rückt es in die Mitte und wird größer. */
.sp-geschuetz.sp-vorposten { transform: translate(32%, -30%) scale(1.8); transform-origin: 18% 82%; z-index: 7; }
.sp-dorf > button { flex: 0 0 auto; font-size: 11.5px; padding: 4px 7px; min-height: 30px; white-space: nowrap; }
.sp-dorf-kaputt > i { filter: grayscale(.9); opacity: .6; }
.sp-dorf-kaputt b::after { content: " · kaputt"; color: #ff8a80; font-weight: 700; }
@media (prefers-reduced-motion: reduce) { .sp-graben-welle, .sp-diamant-funkeln { animation: none; } }
