.sp-daemon-welle { position: fixed; z-index: 9992; margin: 0; border-radius: 50%; pointer-events: none; transform: translate(-50%, -50%);
  border: 4px solid #b0172f; box-shadow: 0 0 18px 6px rgba(123, 31, 214, .75), inset 0 0 14px rgba(176, 23, 47, .7); animation: spDaemonWelle 1.2s ease-out forwards; }
