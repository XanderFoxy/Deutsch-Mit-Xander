  background: #f2c230; color: #2a1f05; font: 800 9px/13px system-ui, sans-serif; }
.sp-schnell .sp-rad-waffe.sp-an { background: #3c7a55; box-shadow: 0 0 0 2px #9fe0b5, 0 2px 6px rgba(0,0,0,.4); }
.sp-schnell .sp-rad-mitte { background: #59627a; width: 34px; height: 34px; left: calc(50% - 17px); bottom: 2px; }
.sp-schnell .sp-rad-mitte svg { width: 18px; height: 18px; }
@keyframes spRadAuf { from { opacity: 0; transform: scale(.85); transform-origin: 50% 100%; } to { opacity: 1; transform: none; } }

/* =========================================================
   FASSUNG 650 — ZAUBER: Nebel, Erdbeben, Orkan
   XANDER: „Zauber oder Erdbeben Orkane … Gegner von der
   Bildfläche werfen oder durcheinanderbringen … Nebeln".
   Nebel liegt als Ring ums Bild – die Gesichtsmitte bleibt
   frei. Beben und Orkan laufen 3,6–3,8 s, wie ihre Töne.
   ========================================================= */
.sp-schnell .sp-s-zauber svg { width: 20px; height: 20px; }
.sp-schnell .sp-s-zauber.sp-an { background: #3b2a66; box-shadow: 0 0 0 2px #b79cff; animation: spZauberBereit 1.2s ease-in-out infinite; }
.sp-schnell .sp-s-zauber.sp-offen { background: #3b2a66; }
.sp-schnell .sp-s-zauber.sp-zu { opacity: .55; }
@keyframes spZauberBereit { 50% { box-shadow: 0 0 0 3px #d9c9ff, 0 0 10px #b79cff; } }
.sp-schnell .sp-rad-zauber { background: #3b2a66; }
.sp-schnell .sp-rad-zauber small { background: #7fb6ff; color: #0d2240; }
.sp-schnell .sp-rad-zauber.sp-zu { background: #474b57; opacity: .75; }
.sp-schnell .sp-rad-zauber.sp-zu svg { filter: grayscale(1); opacity: .6; }
.sp-schnell .sp-rad-zauber.sp-zu small { background: #9aa0ab; color: #1c1f26; }
.sp-schnell .sp-rad-zauber.sp-stumpf small { background: #e2403a; color: #fff; }
.sp-sm-liste .sp-zu { opacity: .6; }
.sp-sm-zbild { display: inline-flex; width: 20px; height: 20px; vertical-align: middle; margin-right: 6px; }
.sp-sm-zbild svg { width: 20px; height: 20px; }
body.sp-kampf #lcPlaetze .lc-platz.sp-w-wackel .lc-kreis { cursor: crosshair; }

/* Nebel am Platz: ein grauer Ring, innen frei */
.sp-nebel { position: absolute; pointer-events: none; z-index: 4; border-radius: 50%; transform: scale(1.55);
  background: radial-gradient(circle, rgba(222,228,235,0) 40%, rgba(150,162,176,.78) 52%, rgba(170,180,192,.6) 62%, rgba(190,198,208,0) 72%);
  animation: spNebelWabern 3.2s ease-in-out infinite alternate; }
.sp-nebel::before, .sp-nebel::after { content: ""; position: absolute; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(160,172,186,.85), rgba(160,172,186,0) 70%); }
.sp-nebel::before { width: 46%; height: 30%; left: -8%; top: 58%; animation: spNebelZiehen 4.5s ease-in-out infinite alternate; }
.sp-nebel::after { width: 40%; height: 26%; right: -6%; top: 8%; animation: spNebelZiehen 5.2s ease-in-out infinite alternate-reverse; }
@keyframes spNebelWabern { from { transform: scale(1.5) rotate(0deg); opacity: .85; } to { transform: scale(1.62) rotate(14deg); opacity: 1; } }
@keyframes spNebelZiehen { from { transform: translate(0, 0); } to { transform: translate(18%, -12%); } }
.sp-nebel-schwade { position: fixed; z-index: 60; pointer-events: none; margin: 0; border-radius: 50%; transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(150,162,176,.9), rgba(150,162,176,0) 70%); animation: spSchwadeRein 1.2s ease-out forwards; }
@keyframes spSchwadeRein { from { transform: translate(calc(-50% + var(--nx)), calc(-50% + var(--ny))) scale(.6); opacity: 0; }
  40% { opacity: 1; } to { transform: translate(-50%, -50%) scale(1.1); opacity: 0; } }
/* Wer selbst im Nebel steckt, sieht den Raum verschleiert. */
body.sp-ich-nebel #lcPlaetze .lc-platz:not(.lc-platz-ich) .lc-kreis { filter: blur(1.6px) grayscale(.5) brightness(1.08); transition: filter .6s; }

/* Wackeln nach Beben und Orkan: die Hand zittert */
.lc-platz.sp-w-wackel .lc-kreis { animation: spWackeln .22s linear infinite; }
@keyframes spWackeln { 25% { transform: translate(1px, -1px) rotate(.6deg); } 75% { transform: translate(-1px, 1px) rotate(-.6deg); } }

/* Erdbeben */
.lc-platz.sp-bebt .lc-kreis { animation: spBeben 3.6s ease-out; }
@keyframes spBeben {
  0% { transform: none; } 4% { transform: translate(-6px, 2px) rotate(-3deg); } 8% { transform: translate(6px, -2px) rotate(3deg); }
  12% { transform: translate(-7px, 1px) rotate(-2deg); } 16% { transform: translate(7px, 2px) rotate(2deg); } 22% { transform: translate(-5px, -2px) rotate(-2deg); }
  30% { transform: translate(5px, 1px) rotate(1.5deg); } 40% { transform: translate(-4px, 1px) rotate(-1deg); } 52% { transform: translate(3px, -1px) rotate(1deg); }
  66% { transform: translate(-2px, 1px); } 80% { transform: translate(1px, 0); } 100% { transform: none; } }
#lcPlaetze.sp-raum-bebt { animation: spRaumBeben .9s ease-out; }
@keyframes spRaumBeben { 10% { transform: translate(-3px, 1px); } 25% { transform: translate(3px, -1px); } 40% { transform: translate(-2px, 1px); } 60% { transform: translate(2px, 0); } 100% { transform: none; } }
.sp-beben-riss { position: fixed; z-index: 60; pointer-events: none; height: 14px; transform: translate(-50%, -50%); animation: spRissWeg 3.6s ease-in forwards; }
.sp-beben-riss svg { width: 100%; height: 100%; overflow: visible; }
.sp-beben-riss path { stroke-dasharray: 100; stroke-dashoffset: 100; animation: spRissAuf .7s ease-out .1s forwards; }
@keyframes spRissAuf { to { stroke-dashoffset: 0; } }
@keyframes spRissWeg { 0%, 75% { opacity: 1; } 100% { opacity: 0; } }
.sp-beben-staub { position: fixed; z-index: 61; pointer-events: none; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; opacity: 0;
  background: radial-gradient(circle, rgba(160,120,80,.85), rgba(160,120,80,0) 70%); animation: spStaub 1.3s ease-out forwards; }
@keyframes spStaub { 0% { opacity: 0; transform: none; } 20% { opacity: .9; } 100% { opacity: 0; transform: translateY(var(--sy)) scale(2.4); } }

/* Orkan: der Wirbel hebt das Bild vom Platz und setzt es wieder ab */
.lc-platz.sp-weggeweht .lc-kreis { animation: spWeggeweht 3.8s cubic-bezier(.45, 0, .4, 1); z-index: 5; }
@keyframes spWeggeweht {
  0% { transform: none; opacity: 1; }
  18% { transform: translateY(-6px) rotate(-200deg) scale(.92); opacity: 1; }
  36% { transform: translate(-42vw, -40px) rotate(-620deg) scale(.55); opacity: .0; }
  58% { transform: translate(42vw, -30px) rotate(-760deg) scale(.55); opacity: 0; }
  80% { transform: translate(0, -8px) rotate(-1040deg) scale(.95); opacity: 1; }
  100% { transform: rotate(-1080deg); opacity: 1; } }
.sp-orkan { position: fixed; z-index: 60; pointer-events: none; transform: translate(-50%, -58%); animation: spOrkan 3.8s ease-in-out forwards; }
.sp-orkan svg { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 0 1.5px rgba(30,45,70,.9)) drop-shadow(0 2px 4px rgba(30,45,70,.45)); }
.sp-orkan-dreh { animation: spOrkanDreh .5s linear infinite; transform-origin: 0 0; }
@keyframes spOrkanDreh { from { transform: scaleX(1); } 50% { transform: scaleX(-1); } to { transform: scaleX(1); } }
@keyframes spOrkan { 0% { opacity: 0; transform: translate(-50%, -58%) scale(.3); } 15% { opacity: 1; transform: translate(-50%, -58%) scale(1); }
  45% { transform: translate(-58%, -60%) scale(1.08); } 70% { transform: translate(-44%, -57%) scale(1.02); opacity: 1; } 100% { opacity: 0; transform: translate(-50%, -62%) scale(.6); } }
@media (prefers-reduced-motion: reduce) {
  .sp-nebel, .sp-nebel::before, .sp-nebel::after, .lc-platz.sp-w-wackel .lc-kreis, .lc-platz.sp-bebt .lc-kreis, #lcPlaetze.sp-raum-bebt,
  .lc-platz.sp-weggeweht .lc-kreis, .sp-orkan-dreh, .sp-schnell .sp-s-zauber.sp-an { animation: none; }
}

/* =========================================================
   FASSUNG 651 — Mauer hinter Ringen und Tieren
   XANDER: „die Mauer verdeckt … unseren Lebensstand … und
   unser kleines Fellmonster". Reihenfolge von hinten nach
   vorn: Mauer (5) · Ringe (6) · Tiere und Turm (9).
   ========================================================= */
.sp-mauer { z-index: 5; }
.sp-lp { z-index: 6; }
.sp-tier, .sp-geschuetz, .sp-flugtier { z-index: 9; }

/* Controller-Ei, Menü links, nichts ragt rechts hinaus (Fassung 651) */
.sp-schnell .sp-s-reihe { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; }
.sp-schnell .sp-s-reihe::-webkit-scrollbar { display: none; }
.sp-schnell .sp-s-ei { padding: 1px 3px; background: rgba(255, 255, 255, .08); }
.sp-schnell .sp-s-ei svg { width: 22px; height: 22px; }
.sp-schnell .sp-s-ei.sp-an { background: #f0e6c8; box-shadow: 0 0 0 2px #e8b923; }
.sp-schnell .sp-s-ei.sp-s-ei-zu { animation: spEiWippen 2.4s ease-in-out infinite; }
@keyframes spEiWippen { 0%, 80%, 100% { transform: none; } 86% { transform: rotate(-9deg); } 93% { transform: rotate(7deg); } }
.sp-schnell .sp-s-slot { position: relative; }
.sp-schnell .sp-s-tacho { position: absolute; left: 50%; top: -5px; width: 14px; height: 9px; margin-left: -7px; border-radius: 7px 7px 0 0;
  background: #3c7a55; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.sp-schnell .sp-s-tacho svg { width: 11px; height: 7px; }
.sp-schnellmenue { max-width: calc(100vw - 16px); box-sizing: border-box; }
@media (prefers-reduced-motion: reduce) { .sp-schnell .sp-s-ei.sp-s-ei-zu { animation: none; } }

/* =========================================================
   FASSUNG 652 — Töne regeln, eckiger Controller-Knopf
   XANDER: „ein Menü, wo man die Sounds … regeln kann" und
   „nicht so ein queren Symbol, sondern einfach ein kleines
   viereckiges Symbol mit dem Game Controller".
   ========================================================= */
.sp-sm-laut { display: flex; align-items: center; gap: 4px; margin: 0 0 6px; }
.sp-sm-laut span { color: #cfd6e4; font: 700 12px system-ui, sans-serif; margin-right: 4px; }
.sp-schnell .sp-sm-laut button { flex: 1 1 0; min-width: 0; min-height: 30px; padding: 2px 4px; font-size: 12px; }
.sp-schnell .sp-s-ei { width: 34px; height: 32px; min-width: 34px; padding: 0; border-radius: 8px; background: #3a4358; }
.sp-schnell .sp-s-ei svg { width: 24px; height: 24px; }

/* Das volle Waffenrad (Fassung 652): Sektoren nach Klasse */
.sp-schnell .sp-rad.sp-rad-voll { position: fixed; bottom: auto; z-index: 9990; animation: spRadVollAuf .18s ease-out; }
@keyframes spRadVollAuf { from { opacity: 0; transform: scale(.85); } to { opacity: 1; transform: none; } }
.sp-rad-sektoren { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
.sp-rad-sektoren .sp-rad-scheibe { fill: rgba(20, 24, 34, .88); stroke: rgba(255, 255, 255, .12); stroke-width: 1; }
.sp-rad-sektoren path { fill: none; stroke-width: 46; stroke-linecap: round; opacity: .38; }
.sp-rad-sektoren text { font: 800 10px/1 system-ui, sans-serif; text-anchor: middle; dominant-baseline: middle; letter-spacing: .04em; text-transform: uppercase;
  paint-order: stroke; stroke: rgba(20, 24, 34, .9); stroke-width: 3px; filter: brightness(1.5); }
.sp-schnell .sp-rad-voll .sp-rad-waffe { box-shadow: 0 0 0 2px var(--klasse, #59627a), 0 2px 6px rgba(0,0,0,.45); }
.sp-schnell .sp-rad-voll .sp-rad-waffe.sp-an { background: #3c7a55; box-shadow: 0 0 0 3px #9fe0b5, 0 2px 6px rgba(0,0,0,.45); }
.sp-schnell .sp-rad-voll .sp-rad-mitte { width: 40px; height: 40px; bottom: auto; }

/* Die Kanone feuert sichtbar (Fassung 652) */
.sp-geschuetz.sp-feuert svg { transform-origin: 40% 70%; animation: spTurmFeuer .7s ease-out; }
@keyframes spTurmFeuer {
  0% { transform: rotate(0); } 12% { transform: rotate(var(--zielwinkel, 0deg)); }
  20% { transform: rotate(var(--zielwinkel, 0deg)) translate(-2px, 2px); } 30% { transform: rotate(var(--zielwinkel, 0deg)); }
  40% { transform: rotate(var(--zielwinkel, 0deg)) translate(-2px, 2px); } 55% { transform: rotate(var(--zielwinkel, 0deg)); } 100% { transform: rotate(0); } }
.sp-muendung { position: fixed; z-index: 9993; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, #fff7c2 0%, #ffcc3a 35%, rgba(255, 110, 20, .8) 60%, rgba(255, 110, 20, 0) 72%); animation: spMuendung .26s ease-out forwards; }
@keyframes spMuendung { from { transform: scale(.4); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .sp-geschuetz.sp-feuert svg { animation: none; } }

/* =========================================================
   FASSUNG 654 — deutsche Zauber: Brezelflut, Mückenschwarm,
   Kaffeeklatsch, Hexenschuss, Gartenzwerg, Behördengang
   ========================================================= */
.sp-sm-liste > p { grid-column: 1 / -1; margin: 2px 0; }
.sp-schnell .sp-zauberrad .sp-rad-zauber { background: #2f2748; box-shadow: 0 0 0 2px var(--klasse, #6d3fa0), 0 2px 6px rgba(0,0,0,.45); }
.sp-brezelregen { position: fixed; z-index: 9991; width: 22px; height: 16px; margin: -8px 0 0 -11px; pointer-events: none; opacity: 0;
  animation: spBrezelFall 1.1s cubic-bezier(.5, 0, .9, .6) forwards; }
.sp-brezelregen svg { width: 100%; height: 100%; }
@keyframes spBrezelFall { 0% { opacity: 1; transform: translateY(-140px) rotate(0); } 85% { opacity: 1; transform: translateY(0) rotate(var(--dreh)); }
  100% { opacity: 0; transform: translateY(6px) rotate(var(--dreh)) scale(.8); } }
.sp-muecke { position: fixed; z-index: 9991; width: 12px; height: 8px; margin: -4px 0 0 -6px; pointer-events: none;
  animation: spMueckeKreis 1.2s linear infinite; }
.sp-muecke svg { width: 100%; height: 100%; display: block; animation: spMueckeZucken .12s linear infinite alternate; }
@keyframes spMueckeKreis { from { transform: rotate(0deg) translateX(var(--bahn)) rotate(0deg); } to { transform: rotate(360deg) translateX(var(--bahn)) rotate(-360deg); } }
@keyframes spMueckeZucken { from { transform: translateY(-1px); } to { transform: translateY(1px); } }
.sp-kaffee { position: fixed; z-index: 9991; width: 30px; height: 30px; margin: -15px 0 0 -15px; pointer-events: none; animation: spKaffee 2.4s ease-out forwards; }
.sp-kaffee svg { width: 100%; height: 100%; }
@keyframes spKaffee { 0% { opacity: 0; transform: translateY(8px) scale(.6); } 15% { opacity: 1; transform: none; } 80% { opacity: 1; } 100% { opacity: 0; transform: translateY(-10px); } }
.sp-besen { position: fixed; z-index: 9991; width: 30px; height: 30px; margin: -15px 0 0 -15px; pointer-events: none; animation: spBesen 1s ease-in forwards; }
.sp-besen svg { width: 100%; height: 100%; }
@keyframes spBesen { 0% { transform: translate(-140px, -80px) rotate(-20deg); opacity: 0; } 20% { opacity: 1; } 70% { transform: translate(0, 0) rotate(10deg); opacity: 1; } 100% { transform: translate(10px, 4px) rotate(30deg); opacity: 0; } }
.lc-platz.sp-w-hexe .lc-kreis { transform: rotate(-11deg) translateX(-2px); transition: transform .3s; }
.sp-zwerg { position: absolute; pointer-events: none; z-index: 8; }
.sp-zwerg svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; animation: spZwergRein .5s ease-out; }
@keyframes spZwergRein { from { transform: scale(.4); opacity: 0; } to { transform: none; opacity: 1; } }
.sp-puff { position: fixed; z-index: 9991; width: 70px; height: 70px; margin: -35px 0 0 -35px; border-radius: 50%; pointer-events: none;
  background: radial-gradient(circle, rgba(255,255,255,.95), rgba(230,220,255,.6) 45%, rgba(230,220,255,0) 70%); animation: spPuff .9s ease-out forwards; }
@keyframes spPuff { from { transform: scale(.3); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
.sp-formular { position: absolute; pointer-events: none; z-index: 8; }
.sp-formular i { position: absolute; left: -16%; top: -8%; width: 38%; height: 38%; transform: rotate(-12deg); filter: drop-shadow(0 1px 2px rgba(0,0,0,.35)); animation: spFormularWackel 2s ease-in-out infinite; }
.sp-formular svg { width: 100%; height: 100%; }
@keyframes spFormularWackel { 50% { transform: rotate(-6deg) translateY(-2px); } }
.sp-formularflug { position: fixed; z-index: 9991; width: 34px; height: 34px; margin: -17px 0 0 -17px; pointer-events: none; animation: spFormularFlug 1.1s ease-out forwards; }
.sp-formularflug svg { width: 100%; height: 100%; }
@keyframes spFormularFlug { 0% { transform: translate(90px, -110px) rotate(40deg) scale(.6); opacity: 0; } 30% { opacity: 1; } 70% { transform: translate(0, 0) rotate(-10deg) scale(1.2); } 80% { transform: scale(1.35) rotate(-10deg); } 100% { transform: scale(1) rotate(-12deg); opacity: 0; } }
.sp-brezelbauch { position: absolute; pointer-events: none; z-index: 8; }
.sp-brezelbauch i { position: absolute; width: 30%; height: 22%; bottom: 2%; }
.sp-brezelbauch i:first-child { left: -8%; transform: rotate(-18deg); }
.sp-brezelbauch i:last-child { left: 6%; bottom: -8%; transform: rotate(12deg); }
.sp-brezelbauch svg { width: 100%; height: 100%; }
@media (prefers-reduced-motion: reduce) {
  .sp-muecke, .sp-muecke svg, .sp-formular i, .sp-zwerg svg { animation: none; }
}

/* =========================================================
   FASSUNG 655 — Controller = Mitspielen, Menü darüber
   XANDER: „Wenn der Gaming Controller angeschaltet ist, dann
   leuchtet er schon grün … über dem Controller im Burger Menü".
   ========================================================= */
.sp-schnell .sp-s-ei, .sp-schnell .sp-s-ei.sp-s-mit { display: flex; align-items: center; justify-content: center; width: 36px; height: 34px; min-width: 36px; padding: 0;
  border-radius: 9px; background: #3a4358; box-shadow: none; }
.sp-schnell .sp-s-ei svg { width: 26px; height: 26px; display: block; margin: 0; }
.sp-schnell .sp-s-ei.sp-s-mit.sp-an { background: #2f8a45; box-shadow: 0 0 0 2px #7ee39a, 0 0 10px rgba(59, 191, 74, .7); }
.sp-schnell .sp-s-burger { position: absolute; left: 4px; bottom: calc(100% + 4px); width: 36px; height: 30px; min-width: 36px; padding: 0;
