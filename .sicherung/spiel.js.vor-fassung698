  /* FASSUNG 673 — XANDER: „vielleicht könnte man beim klicken auf das leere
     im Hintergrund sowieso gleich zum einsammeln kommen, dass man nichts
     verpasst". Ein Tipp NEBEN das Fenster schließt es – und der Tipp
     wirkt gleich dort, wo er landet (Fundstück, Platz, Gesicht). */
  document.addEventListener("pointerdown", function (ev) {
    if (!panel || panel.hidden) return;
    var t = ev.target;
    if (!t || !t.closest || panel.contains(t)) return;
