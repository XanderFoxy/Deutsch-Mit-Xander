  /* ---------------------------------------------------------------
     FUNK 100 — ÜBEN MIT DER PUPPE
     ---------------------------------------------------------------
     XANDER: „kann ich das mit dem Dummy testen wenn ich ihn irgendwo
     hin treffe oder das ja zufällig Punkte so an meinem Profilbild
     aussucht wo er mir hinschießt dass ich sehen kann ob das
     funktioniert."
     Die Übungspuppen (/puppe) sitzen nur auf dem eigenen Gerät und
     haben kein Konto. Deshalb rechnet hier der Browser, mit genau den
     Regeln des Servers (spiel_zone, spiel_faktor, spiel_waffe_schaden):
       · Treffer auf die Puppe: Zone, rote Zahl, Lebensbalken, kaputt;
         nach 4 s klebt sie sich ein Pflaster drauf.
       · Übungsduell (Reiter „Duell", Knopf bei der Puppe): die Puppe
         schießt alle paar Sekunden zurück, auf einen ZUFÄLLIGEN Punkt
         deines Bildes. Deine Lebenspunkte zählen nur in der Übung —
         in der Datenbank ändert sich nichts, Punkte gibt es keine.
     --------------------------------------------------------------- */
  function istPuppe(chatId) { return /^(uebungspuppe2?|sparring:\d+)$/.test(String(chatId || "")); }
  function puppeStand(chatId) {
    var sid = "puppe:" + chatId;
    if (!S.stand[sid]) {
      S.stand[sid] = { id: sid, name: chatId === "uebungspuppe2" ? "Dummy" : /^sparring/.test(chatId) ? "Sparring" : "Puppe", lp: 100, lp_max: 100,
                       kaputt: false, schild: 0, mauer_art: null, mauer_lp: 0,
                       haustier: chatId === "uebungspuppe" ? "fellmonster" : null,
                       geschuetz: chatId === "uebungspuppe2", wischer: 0, anfaenger: false, verdient: 0, uebung: true };
    }
    return S.stand[sid];
  }
  function zoneRechnen(dx, dy) {
    var d = Math.hypot(dx, dy);
    if (d > 1) return "daneben";
    if (Math.hypot(dx, dy + 0.3) <= 0.3) return "kopf";
    if (Math.hypot(dx - 0.18, dy - 0.35) <= 0.2) return "herz";
    return d <= 0.7 ? "koerper" : "streif";
  }
  var FAKTOR = { kopf: 2.0, herz: 1.6, koerper: 1.0, streif: 0.5, daneben: 0 };
  function schadenRechnen(waffe, zone) {
    return Math.round(((WAFFEN[waffe] || WAFFEN.bogen).schaden) * (FAKTOR[zone] || 0));
  }
  function puppeGetroffen(p, waffe, dx, dy) {
    var st = puppeStand(p.id);
    if (st.kaputt) { zahlZeigen(p.id, null, "schon kaputt"); return; }
    var zone = zoneRechnen(dx, dy), schaden = schadenRechnen(waffe, zone);
    st.lp = Math.max(0, st.lp - schaden);
    st.kaputt = st.lp <= 0;
    trefferZeigen(p.id, { zone: zone, schaden: schaden, abgewehrt: 0, kaputt: st.kaputt });
    /* FUNK 109/110 — Gegenwehr zum Ausprobieren: die Puppe hat ein
       Fellmonster, der Dummy ein Geschütz. Gerechnet wie auf dem Server
       (spiel_treffer); die Lebenspunkte zählen nur im Übungsduell. */
    if (schaden > 0) {
      var gg = p.id === "uebungspuppe2" ? Math.max(2, Math.min(18, Math.round(schaden * 0.5))) : 0;
      var gt = p.id === "uebungspuppe" ? Math.max(2, Math.min(10, Math.round(schaden * 0.3))) : 0;
      var gw = Math.min(gg + gt, Math.max(2, Math.round(schaden * 0.8)));
      if (S.uebung) S.uebung.lp = Math.max(0, S.uebung.lp - gw);
      gegenwehrZeigen(p.id, meineChatId(), { gegenwehr: gw, gegen_geschuetz: gg, gegen_tier: gt, tier: gt ? "fellmonster" : "" });
    }
    if (!S.uebungGesagt) { S.uebungGesagt = true; hinweis("🧍 Übung mit " + st.name + " – zählt nicht, keine Punkte."); }
    if (st.kaputt) {
      if (S.duell && S.duell.uebung && S.duell.gegnerChat === p.id) {
        hinweis("🏆 Runde gewonnen – " + st.name + " steht gleich wieder auf.");
      }
      setTimeout(function () {
        st.lp = st.lp_max; st.kaputt = false;
        zahlZeigen(p.id, st.lp_max, "Pflaster");
        zeichnen();
      }, 4000);
    }
    zeichnen();
  }
  function meinPlatzNummer() {
    var ich = meineChatId(), n = null;
    plaetze().forEach(function (q) { if (q.id === ich) n = q.nummer; });
    return n;
  }
  function uebungStarten(chatId) {
    if (!istPuppe(chatId) || !platzElVon(chatId)) return false;
    var st = puppeStand(chatId);
    st.lp = st.lp_max; st.kaputt = false;
    var max = (S.ich && S.ich.lp_max) || 100;
    S.uebung = { lp: max, max: max };
    /* FASSUNG 641 — XANDER: „der Sparring Partner der schießt immer nur
       zurück wenn ich wieder neu auf … geht, das soll eingeloggt bleiben".
       Das Übungsduell läuft, bis man es ausschaltet (vorher: 3 Minuten). */
    S.duell = { id: "uebung", gegner: "puppe:" + chatId, gegnerChat: chatId, bis: Date.now() + 36e6, uebung: true };
    hinweis("⚔️ Übung mit " + st.name + ": sie schießt zurück, bis du es ausschaltest (Menü → Mehr). Deine Tiere und dein Turm wehren sich mit. Zählt nicht.");
    schliessen();
    puppeSchussPlanen();
    zeichnen();
    return true;
  }
  function uebungEnde() {
    if (S.duell && S.duell.uebung) S.duell = null;
    clearTimeout(S.puppeUhr);
    S.uebung = null;
    zeichnen();
    panelAuffrischen();
  }
  /* Die eigene Gegenwehr, lokal gerechnet wie spiel_treffer (für die Übung). */
  function eigeneGegenwehr(roh) {
    /* FASSUNG 697 — dieselben Tiere und Zahlen wie spiel_treffer. Vorher kannte die Übung nur
       Fellmonster, Stachelmonster, Chihuahua, Drache und Eule; Schäferhund, Einhorn, Dackel,
       Wolpertinger, Feuerfuchs, Phönix, Storch, Greif, Lindwurm, Regenbogendrache wehrten
       sich in der Übung schwächer als im echten Kampf. */
    var ich = S.ich || {}, tf = 1 + 0.1 * Number(((ich.skills || {}).tierfreund) || 0), ing = 1 + 0.1 * Number(((ich.skills || {}).ingenieur) || 0);
    var st = Math.max(1, Math.min(5, ich.geschuetz_stufe || 1)), gg = 0, gt = 0, gf = 0, heil = 0;
    var R = Math.round, anteil = function (min, max, f) { return Math.max(min, Math.min(max, R(roh * f))); };
    if ((ich.geschuetz_ladungen || 0) > 0) gg = Math.max(2, Math.min(st >= 5 ? 26 : st >= 4 ? 22 : 18, R(roh * (0.3 + 0.2 * Math.min(3, st)) * ing)));
    if (ich.haustier && ich.haustier_leben > 0) {
      var hst = ich.haustier_stufe || 1, plus = hst >= 2 ? 2 : 0, hs = 1 + 0.15 * (Math.max(1, Math.min(3, hst)) - 1);
      var b = ({
        drache: function () { return anteil(3, 16, 0.5); },
        stachelmonster: function () { return anteil(1, 8, 0.2); },
        chihuahua: function () { return anteil(2, 9, 0.25) + plus; },
        schaeferhund: function () { return anteil(3, 14, 0.35) + plus; },
        babyfuchs: function () { return anteil(1, 7, 0.2); },
        einhorn: function () { return anteil(3, 14, 0.35); },
        dackel: function () { return anteil(2, 9, 0.25) + plus; },
        wolpertinger: function () { return anteil(3, 16, 0.5) + plus; },
        feuerfuchs: function () { return anteil(3, 15, 0.45) + plus; }
      }[ich.haustier] || function () { return anteil(2, 10, 0.3); })();
      gt = R(b * hs * tf);
      if (ich.haustier === "fellmonster" && hst >= 2) heil = 3;
      if (ich.haustier === "einhorn" && hst >= 2) heil += 2;
    }
    if (ich.flugtier && ich.flugtier_leben > 0) {
      var fst = ich.flugtier_stufe || 1, fs = 1 + 0.15 * (Math.max(1, Math.min(3, fst)) - 1);
      var fb = ({
        drache: function () { return anteil(3, 16, 0.5) + (fst >= 2 ? 2 : 0); },
        phoenix: function () { return anteil(3, 15, 0.45); },
        storch: function () { return anteil(2, 12, 0.35); },
        lindwurm: function () { return anteil(4, 19, 0.6); },
        greif: function () { return anteil(3, 16, 0.5); },
        regenbogendrache: function () { return anteil(4, 18, 0.55); }
      }[ich.flugtier] || function () { return anteil(2, 8, 0.25); })();
      gf = R(fb * fs * tf);
      if (ich.flugtier === "phoenix" && fst >= 2) heil += 2;
      if (ich.flugtier === "regenbogendrache" && fst >= 2) heil += 3;
    }
    /* Höchstens vier Fünftel des angerichteten Schadens (auch bei 1 Schaden nicht mehr als 1). */
    var gesamt = Math.min(gg + gt + gf, Math.max(1, R(roh * 0.8)));
    if (!(gg + gt + gf) || !(roh > 0)) gesamt = 0;
    return { gegenwehr: gesamt, gegen_geschuetz: gg, gegen_tier: gt, tier: gt ? ich.haustier : "", gegen_flug: gf, flugtier: gf ? ich.flugtier : "", tier_heil: heil };
  }
  function puppeSchussPlanen() {
    clearTimeout(S.puppeUhr);
    S.puppeUhr = setTimeout(puppeSchiesst, 2600 + Math.floor(Math.random() * 1900));
  }
  function puppeSchiesst() {
    var d = S.duell;
    if (!d || !d.uebung || !S.uebung) return;
    if (Date.now() > d.bis) { hinweis("⏱️ Übungsduell vorbei – unentschieden."); uebungEnde(); return; }
    var gegner = d.gegnerChat, ich = meineChatId();
    if (!platzElVon(gegner) || !platzElVon(ich)) { uebungEnde(); return; }
    var st = puppeStand(gegner);
    if (st.kaputt || S.uebung.lp <= 0) { puppeSchussPlanen(); return; }
    /* Ein zufälliger Punkt. Ganz gleichmäßig verteilt träfe die Puppe
       fast nur Rand und Körper — Kopf und Herz sind kleine Flächen, und
       man sähe kaum, ob sie zählen. Deshalb lost sie zuerst die ZONE
       (Kopf 25 %, Herz 15 %, Körper 35 %, Rand 15 %, daneben 10 %) und
       dann einen zufälligen Punkt darin. */
    var los = Math.random(), wunsch = los < 0.25 ? "kopf" : los < 0.4 ? "herz" : los < 0.75 ? "koerper" : los < 0.9 ? "streif" : "daneben";
    var dx = 0, dy = 0;
    for (var v = 0; v < 400; v++) {
      dx = Math.round((Math.random() * 2.3 - 1.15) * 100) / 100;
      dy = Math.round((Math.random() * 2.3 - 1.15) * 100) / 100;
      if (zoneRechnen(dx, dy) === wunsch) break;
    }
    var arten = ["zwille", "bogen", "laser", "armbrust", "tomahawk"];
    var waffe = arten[Math.floor(Math.random() * arten.length)];
    var farbe = LASERFARBEN[Math.floor(Math.random() * LASERFARBEN.length)];
    var nummer = meinPlatzNummer();
    var dauer = geschossZeigen(gegner, ich, waffe, dx, dy, farbe);
    setTimeout(function () {
      if (!S.uebung || !S.duell || !S.duell.uebung) return;
      if (meinPlatzNummer() !== nummer) { zahlZeigen(ich, null, "ausgewichen"); puppeSchussPlanen(); return; }
      var zone = zoneRechnen(dx, dy), schaden = schadenRechnen(waffe, zone);
      S.uebung.lp = Math.max(0, S.uebung.lp - schaden);
      trefferZeigen(ich, { zone: zone, schaden: schaden, abgewehrt: 0, kaputt: S.uebung.lp <= 0 });
      /* XANDER: „mein Drachen macht übrigens gar nix … wenn ich gegen den
         Sparring Partner kämpfe, sehe ich nicht, dass der … reagiert".
         Jetzt wehren sich die eigenen Tiere und der Turm auch in der
         Übung — gerechnet wie auf dem Server (spiel_treffer). */
      if (schaden > 0) {
        var gw = eigeneGegenwehr(schaden);
        if (gw.gegenwehr > 0 || gw.tier_heil > 0) {
          st.lp = Math.max(0, st.lp - gw.gegenwehr); st.kaputt = st.lp <= 0;
          if (gw.tier_heil > 0) S.uebung.lp = Math.min(S.uebung.max, S.uebung.lp + gw.tier_heil);
          gegenwehrZeigen(ich, gegner, gw);
        }
      }
      zeichnen();
      if (S.uebung.lp <= 0 || st.kaputt) {
        var ichVerloren = S.uebung.lp <= 0;
        hinweis(ichVerloren ? "💔 " + st.name + " hat die Runde gewonnen – weiter geht's." : "🏆 Runde gewonnen – " + st.name + " steht gleich wieder auf.");
        setTimeout(function () {
          if (!S.uebung) return;
          S.uebung.lp = S.uebung.max; st.lp = st.lp_max; st.kaputt = false;
          zeichnen(); puppeSchussPlanen();
        }, 2500);
        return;
      }
      puppeSchussPlanen();
    }, dauer);
  }

  /* ---------------------------------------------------------------
     SENDEN / EMPFANGEN über den Raumkanal
     --------------------------------------------------------------- */
  function senden(o) { try { var l = LC(); if (l && l.spielSenden) l.spielSenden(o); } catch (e) {} }

  function empfangen(n) {
    if (!n || !n.ereignis) return;
    if (n.stand && n.stand.id) S.stand[n.stand.id] = n.stand;
    if (n.ziel_stand && n.ziel_stand.id) S.stand[n.ziel_stand.id] = n.ziel_stand;
    if (n.ich_stand && n.ich_stand.id) S.stand[n.ich_stand.id] = n.ich_stand;
    /* Wer nicht mitspielt, bekommt nur den Stand – keine Bilder, keine Töne. */
